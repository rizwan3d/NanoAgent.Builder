@page
@model NanoAgent.Builder.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["UseBuilderLayout"] = true;
}

<section class="app-auth-shell">
    <div class="container-xl px-3 px-lg-4">
        <div class="app-auth-grid">
            <div class="app-auth-hero">
                <p class="app-kicker mb-2">Secure access</p>
                <h1>Welcome back.</h1>
                <p class="mb-0">Sign in to reopen your workspace, continue active projects, and review plan usage without losing context.</p>

                <div class="app-auth-points">
                    <div class="app-auth-point">
                        <strong>One place for chat, files, and preview</strong>
                        <div class="small visually-muted mt-1">Pick up exactly where the last run stopped.</div>
                    </div>
                    <div class="app-auth-point">
                        <strong>Plan-aware workspace</strong>
                        <div class="small visually-muted mt-1">Model access and usage limits stay visible while you work.</div>
                    </div>
                </div>
            </div>

            <div class="app-auth-card">
                <p class="app-kicker mb-2">Sign in</p>
                <h2 class="h3 mb-3">Access your account</h2>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                </form>

                <p class="mt-3 mb-0 text-center">
                    <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Create a new account</a>
                </p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
