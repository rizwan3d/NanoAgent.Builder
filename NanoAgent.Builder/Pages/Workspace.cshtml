@page
@model WorkspaceModel
@{
    ViewData["Title"] = "Workspace";
    var defaultPreviewUrl = "/Plans";
    var allowedModels = Model.Workspace?.AllowedModels ?? Model.CurrentUsage?.AllowedLlmModels ?? Array.Empty<string>();
    var selectedFile = Model.Workspace?.Files.FirstOrDefault();
    var monacoLanguage = selectedFile?.Language ?? "typescript";
    var monacoContent = selectedFile?.Content ?? "// Create a project file to load Monaco content.";
    var tokenUsagePercent = Model.CurrentUsage is null || Model.CurrentUsage.MonthlyTokenLimit == -1
        ? 0
        : Math.Min(100, (int)Math.Round(Model.CurrentUsage.UsedTokens * 100d / Model.CurrentUsage.MonthlyTokenLimit));
}

<div class="builder-shell workspace-shell">
    <aside class="builder-chat-panel workspace-chat-panel">
        <div class="builder-panel-header">
            <div>
                <p class="builder-eyebrow mb-1">Workspace</p>
                <h1 class="builder-title mb-1">@Model.SelectedProjectName</h1>
                <p class="text-muted small mb-0">Chat is stored in <code>ProjectMessages</code> and each request creates a <code>ProjectRuns</code> row.</p>
            </div>
            <span class="builder-status-pill">Storage on</span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        }

        <div class="workspace-plan-card">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <div class="builder-eyebrow mb-1">Plan limits</div>
                    <strong>@(Model.CurrentSubscription?.PlanName ?? Model.CurrentUsage?.PlanName ?? "Free")</strong>
                </div>
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Billing">Billing</a>
            </div>

            @if (Model.CurrentUsage is not null)
            {
                <div class="mt-3 small text-muted">
                    @Model.CurrentUsage.UsedTokens.ToString("N0") / @Model.CurrentUsage.MonthlyTokenLimitDisplay tokens used
                </div>
                <div class="progress builder-progress mt-2" role="progressbar" aria-label="Monthly token usage" aria-valuenow="@tokenUsagePercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @tokenUsagePercent%"></div>
                </div>
                <div class="dashboard-pill-row mt-3">
                    @foreach (var modelName in allowedModels)
                    {
                        <span class="dashboard-pill">@modelName</span>
                    }
                </div>
            }
        </div>

        <div class="builder-chat-feed workspace-chat-feed" aria-label="Project chat messages">
            @if (Model.Workspace?.Messages.Count > 0)
            {
                @foreach (var message in Model.Workspace.Messages)
                {
                    var isUser = string.Equals(message.Role, "user", StringComparison.OrdinalIgnoreCase);
                    <div class="builder-message @(isUser ? "builder-message-user" : "builder-message-ai")">
                        <span class="builder-avatar @(isUser ? string.Empty : "builder-avatar-ai")">@(isUser ? "U" : "N")</span>
                        <div>
                            <div class="builder-message-label">
                                @(isUser ? "You" : "NanoAgent")
                                <span class="text-muted fw-normal"> · @message.LlmModel · @(message.InputTokens + message.OutputTokens) tokens</span>
                            </div>
                            <p>@message.Content</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="builder-message builder-message-ai">
                    <span class="builder-avatar builder-avatar-ai">N</span>
                    <div>
                        <div class="builder-message-label">NanoAgent</div>
                        <p>No project messages yet. Send a prompt to store it, enforce model entitlements, and record token usage.</p>
                    </div>
                </div>
            }
        </div>

        @if (Model.SelectedProject is not null)
        {
            <form method="post" asp-page-handler="Send" asp-route-projectId="@Model.SelectedProject.Id" class="builder-composer" aria-label="Project chat composer">
                <div class="d-grid gap-2">
                    <select asp-for="SendInput.LlmModel" class="form-select builder-input" aria-label="LLM model">
                        @foreach (var modelName in allowedModels)
                        {
                            <option value="@modelName">@modelName</option>
                        }
                    </select>
                    <textarea asp-for="SendInput.Message" class="form-control builder-input" rows="3" placeholder="Ask NanoAgent to change the app..."></textarea>
                    <span asp-validation-for="SendInput.Message" class="text-danger small"></span>
                </div>
                <button class="btn btn-dark align-self-end" type="submit">Send</button>
            </form>
        }
    </aside>

    <main class="workspace-main-panel">
        <div class="workspace-topbar">
            <div>
                <p class="builder-eyebrow mb-1">Workspace page</p>
                <h2 class="builder-stage-title mb-0">Preview and Code tabs</h2>
            </div>
            <div class="workspace-project-switcher">
                <span class="text-muted small">Project</span>
                <select class="form-select form-select-sm builder-input" onchange="if (this.value) window.location.href = this.value;">
                    @if (Model.Projects.Count == 0)
                    {
                        <option>No projects yet</option>
                    }
                    else
                    {
                        @foreach (var project in Model.Projects)
                        {
                            var url = Url.Page("/Workspace", values: new { projectId = project.Id });
                            <option value="@url" selected="@(Model.SelectedProject?.Id == project.Id)">@project.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        @if (Model.Projects.Count == 0)
        {
            <section class="workspace-empty-card">
                <h3 class="h4">Create a project first</h3>
                <p class="text-muted">The workspace opens against a saved project. Create one from the dashboard to activate project-specific storage.</p>
                <a class="btn btn-primary" asp-page="/Index">Go to dashboard</a>
            </section>
        }
        else if (Model.Workspace is not null)
        {
            <section class="workspace-tabs-card" aria-label="Workspace tabs">
                <div class="workspace-tab-header" role="tablist" aria-label="Workspace panels">
                    <button type="button" class="workspace-main-tab active" role="tab" aria-selected="true" aria-controls="workspacePreviewTab" id="workspacePreviewTabButton" data-workspace-tab="preview">
                        Preview
                    </button>
                    <button type="button" class="workspace-main-tab" role="tab" aria-selected="false" aria-controls="workspaceCodeTab" id="workspaceCodeTabButton" data-workspace-tab="code">
                        Code
                    </button>
                </div>

                <div class="workspace-tab-body">
                    <section class="workspace-tab-pane active" id="workspacePreviewTab" role="tabpanel" aria-labelledby="workspacePreviewTabButton" data-workspace-pane="preview">
                        <div class="workspace-preview-panel workspace-preview-panel-tabbed">
                            <div class="workspace-panel-heading">
                                <span>Preview panel</span>
                                <span class="builder-status-pill builder-status-muted">Default tab</span>
                            </div>
                            <div class="builder-browser-toolbar">
                                <button type="button" class="builder-icon-button" id="previewReloadButton" aria-label="Reload preview">↻</button>
                                <div class="builder-address-bar">
                                    <span class="builder-lock">⌁</span>
                                    <input id="previewAddressInput" type="text" value="@defaultPreviewUrl" aria-label="Preview URL" />
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="previewGoButton">Go</button>
                            </div>
                            <iframe id="appPreviewFrame" class="builder-preview-frame workspace-preview-frame" title="Application preview placeholder" src="@defaultPreviewUrl"></iframe>
                        </div>
                    </section>

                    <section class="workspace-tab-pane" id="workspaceCodeTab" role="tabpanel" aria-labelledby="workspaceCodeTabButton" data-workspace-pane="code" hidden>
                        <div class="workspace-code-layout">
                            <section class="workspace-file-tree-panel">
                                <div class="workspace-panel-heading">
                                    <span>ProjectFiles</span>
                                    <span class="builder-status-pill builder-status-muted">DB-backed</span>
                                </div>
                                <div class="builder-file-tree workspace-file-tree">
                                    <div class="builder-tree-title">@Model.SelectedProjectName</div>
                                    @if (Model.Workspace.Files.Count == 0)
                                    {
                                        <div class="text-muted small">No files stored yet.</div>
                                    }
                                    else
                                    {
                                        @foreach (var file in Model.Workspace.Files)
                                        {
                                            <div title="@file.Path">@file.Path</div>
                                        }
                                    }
                                </div>

                                <div class="workspace-artifact-list mt-3">
                                    <div class="workspace-panel-heading">
                                        <span>GeneratedArtifacts</span>
                                        <span class="builder-status-pill builder-status-muted">DB-backed</span>
                                    </div>
                                    @if (Model.Workspace.Artifacts.Count == 0)
                                    {
                                        <div class="text-muted small">No generated artifacts yet.</div>
                                    }
                                    else
                                    {
                                        @foreach (var artifact in Model.Workspace.Artifacts)
                                        {
                                            <div class="workspace-artifact-item">
                                                <strong>@artifact.Name</strong>
                                                <span>@artifact.ArtifactType</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </section>

                            <section class="workspace-editor-panel">
                                <div class="workspace-panel-heading">
                                    <span>Code editor</span>
                                    <span class="builder-status-pill builder-status-muted">Monaco</span>
                                </div>
                                <div class="workspace-editor-placeholder" aria-label="Monaco code editor">
                                    <div class="workspace-tabbar">
                                        @if (Model.Workspace.Files.Count == 0)
                                        {
                                            <span>No file selected</span>
                                        }
                                        else
                                        {
                                            @foreach (var file in Model.Workspace.Files.Take(3))
                                            {
                                                <span>@file.Path</span>
                                            }
                                        }
                                    </div>
                                    <div id="workspaceMonacoEditor" class="workspace-monaco-editor" data-language="@monacoLanguage" aria-label="Monaco editor"></div>
                                    <textarea id="workspaceMonacoSeed" class="visually-hidden" aria-hidden="true" readonly>@monacoContent</textarea>
                                </div>
                            </section>

                            <section class="workspace-logs-panel">
                                <div class="workspace-panel-heading">
                                    <span>ProjectRuns</span>
                                    <span class="builder-status-pill builder-status-muted">DB-backed</span>
                                </div>
                                <div class="workspace-log-lines">
                                    @if (Model.Workspace.Runs.Count == 0)
                                    {
                                        <div><span>[system]</span> No runs yet. Send a chat message to queue one.</div>
                                    }
                                    else
                                    {
                                        @foreach (var run in Model.Workspace.Runs)
                                        {
                                            <div>
                                                <span>[@run.Status]</span>
                                                @run.RequestedModel · @run.InputTokens input tokens · @run.StartedAtUtc.ToLocalTime().ToString("g")
                                            </div>
                                        }
                                    }
                                </div>
                            </section>
                        </div>
                    </section>
                </div>
            </section>
        }
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.2/min/vs/loader.min.js"></script>
    <script>
        if (document.querySelector('[data-workspace-pane="code"].active')) {
            window.initializeWorkspaceMonaco?.();
        }
    </script>
}
