@page
@model NanoAgent.Builder.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin dashboard";
}

<div class="mb-4">
    <p class="text-uppercase text-muted fw-semibold mb-2">Admin</p>
    <h1 class="display-6 fw-bold">SaaS dashboard</h1>
    <p class="lead mb-0">Manage visibility into users, roles, packages, and project usage.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Users</div><div class="h2 mb-0">@Model.Dashboard.TotalUsers</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Projects</div><div class="h2 mb-0">@Model.Dashboard.TotalProjects</div></div></div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm"><div class="card-body"><div class="text-muted small">Active subscriptions</div><div class="h2 mb-0">@Model.Dashboard.ActiveSubscriptions</div></div></div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h4 mb-3">Packages</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Name</th><th>Tier</th><th>Price</th><th>Project limit</th><th>Stripe</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var plan in Model.Dashboard.Plans)
                    {
                        <tr>
                            <td><strong>@plan.Name</strong><div class="small text-muted">@plan.Code</div></td>
                            <td>@plan.Tier</td>
                            <td>@(plan.MonthlyPrice == 0 ? "$0" : plan.MonthlyPrice.ToString("C0")) / month</td>
                            <td>@(plan.ProjectLimit == -1 ? "Unlimited" : plan.ProjectLimit)</td>
                            <td>@(plan.RequiresPayment ? (plan.IsPaymentConfigured ? "Configured" : "Missing price id") : "Not required")</td>
                            <td>@(plan.IsActive ? "Active" : "Inactive")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h4 mb-3">Users</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>User</th><th>Roles</th><th>Package</th><th>Projects</th><th>Created</th></tr></thead>
                <tbody>
                    @foreach (var user in Model.Dashboard.Users)
                    {
                        <tr>
                            <td><strong>@user.Email</strong><div class="small text-muted">@user.DisplayName</div></td>
                            <td>@string.Join(", ", user.Roles)</td>
                            <td>@user.PlanName <span class="small text-muted">(@user.SubscriptionStatus)</span></td>
                            <td>@user.ProjectCount</td>
                            <td>@user.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
