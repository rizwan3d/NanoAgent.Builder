@page
@model NanoAgent.Builder.Pages.Billing.IndexModel
@{
    ViewData["Title"] = "Billing";
    ViewData["UseBuilderLayout"] = true;
}

<section class="app-page">
    <div class="container-xl px-3 px-lg-4">
        <div class="app-page-header">
            <div class="app-page-copy">
                <p class="app-kicker mb-2">Billing</p>
                <h1>Manage plan status and monthly usage.</h1>
                <p class="mb-0">See your current subscription, track token usage, and jump to Stripe when you need to update billing details.</p>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="app-billing-grid">
            <section class="app-billing-card">
                <p class="app-kicker mb-1">Subscription</p>
                <h2 class="h3 mb-3">Current plan</h2>

                @if (Model.CurrentSubscription is null)
                {
                    <div class="app-empty-state text-start">
                        <p class="mb-3">No plan is active for this account yet.</p>
                        <a class="btn btn-primary" asp-page="/Plans">Choose a plan</a>
                    </div>
                }
                else
                {
                    <dl class="row g-3 mb-4">
                        <dt class="col-sm-4">Plan</dt>
                        <dd class="col-sm-8">@Model.CurrentSubscription.PlanName</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.CurrentSubscription.Status</dd>

                        <dt class="col-sm-4">Started</dt>
                        <dd class="col-sm-8">@Model.CurrentSubscription.StartedAtUtc.ToLocalTime().ToString("g")</dd>

                        @if (Model.CurrentSubscription.CurrentPeriodStartsAtUtc is not null)
                        {
                            <dt class="col-sm-4">Period starts</dt>
                            <dd class="col-sm-8">@Model.CurrentSubscription.CurrentPeriodStartsAtUtc.Value.ToLocalTime().ToString("g")</dd>
                        }

                        @if (Model.CurrentSubscription.CurrentPeriodEndsAtUtc is not null)
                        {
                            <dt class="col-sm-4">Period ends</dt>
                            <dd class="col-sm-8">@Model.CurrentSubscription.CurrentPeriodEndsAtUtc.Value.ToLocalTime().ToString("g")</dd>
                        }
                    </dl>

                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-primary" asp-page="/Plans">Change plan</a>
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentSubscription.StripeCustomerId))
                        {
                            <form method="post" asp-page-handler="Portal">
                                <button type="submit" class="btn btn-outline-secondary">Open Stripe portal</button>
                            </form>
                        }
                    </div>
                }
            </section>

            <aside class="app-billing-card">
                <p class="app-kicker mb-1">Usage</p>
                <h2 class="h3 mb-3">Monthly tokens</h2>

                @if (Model.CurrentUsage is null)
                {
                    <p class="mb-0">Sign in and select a plan to see usage.</p>
                }
                else
                {
                    <dl class="row g-3 mb-3">
                        <dt class="col-sm-5">Used</dt>
                        <dd class="col-sm-7">@Model.CurrentUsage.UsedTokens.ToString("N0")</dd>

                        <dt class="col-sm-5">Limit</dt>
                        <dd class="col-sm-7">@Model.CurrentUsage.MonthlyTokenLimitDisplay</dd>

                        <dt class="col-sm-5">Remaining</dt>
                        <dd class="col-sm-7">@Model.CurrentUsage.RemainingTokensDisplay</dd>

                        <dt class="col-sm-5">Period</dt>
                        <dd class="col-sm-7">@Model.CurrentUsage.PeriodStartUtc.ToLocalTime().ToString("d") - @Model.CurrentUsage.PeriodEndUtc.ToLocalTime().ToString("d")</dd>
                    </dl>

                    <div class="dashboard-pill-row">
                        @foreach (var modelName in Model.CurrentUsage.AllowedLlmModels)
                        {
                            <span class="dashboard-pill">@modelName</span>
                        }
                    </div>
                }
            </aside>
        </div>
    </div>
</section>
