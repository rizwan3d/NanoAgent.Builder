@page
@model IndexModel
@{
    ViewData["Title"] = "NanoAgent Builder";
}

<div class="row align-items-center mb-4">
    <div class="col-lg-8">
        <p class="text-uppercase text-muted fw-semibold mb-2">Clean Architecture SaaS starter</p>
        <h1 class="display-5 fw-bold">NanoAgent Builder</h1>
        <p class="lead mb-0">
            Authenticated users create agent projects inside a single database with SaaS package, LLM model, and monthly token limits.
        </p>
    </div>
    <div class="col-lg-4 mt-3 mt-lg-0">
        <div class="border rounded-3 p-3 bg-light">
            <div class="small text-muted">Active database provider</div>
            <div class="fw-semibold">@Model.DatabaseInfo.Provider</div>
            <div class="small text-muted">@Model.DatabaseInfo.ConnectionStringName</div>
            @if (Model.CurrentSubscription is not null)
            {
                <hr />
                <div class="small text-muted">Current package</div>
                <div class="fw-semibold">@Model.CurrentSubscription.PlanName</div>
            }
            @if (Model.CurrentUsage is not null)
            {
                <hr />
                <div class="small text-muted">Monthly token usage</div>
                <div class="fw-semibold">@Model.CurrentUsage.UsedTokens.ToString("N0") / @Model.CurrentUsage.MonthlyTokenLimitDisplay</div>
                <div class="small text-muted">Remaining: @Model.CurrentUsage.RemainingTokensDisplay</div>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h4 mb-3">Create project</h2>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" placeholder="Example: Research Agent" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="What should this agent project do?"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.LlmModel" class="form-label"></label>
                        <select asp-for="Input.LlmModel" class="form-select">
                            @foreach (var modelName in Model.CurrentUsage?.AllowedLlmModels ?? Enumerable.Empty<string>())
                            {
                                <option value="@modelName">@modelName</option>
                            }
                        </select>
                        <span asp-validation-for="Input.LlmModel" class="text-danger"></span>
                        <div class="form-text">Model choices are limited by your current package.</div>
                    </div>

                    <button type="submit" class="btn btn-primary">Save project</button>
                    <a class="btn btn-outline-secondary" asp-page="/Plans">Change package</a>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h4 mb-3">Projects</h2>

                @if (Model.Projects.Count == 0)
                {
                    <p class="text-muted mb-0">No projects yet. Create one to verify auth, SaaS quota, LLM model limits, token entitlements, and database persistence.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var project in Model.Projects)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between gap-3">
                                    <h3 class="h6 mb-1">@project.Name</h3>
                                    <span class="small text-muted text-nowrap">@project.CreatedAtUtc.ToLocalTime().ToString("g")</span>
                                </div>
                                <div class="small text-muted">Model: @project.LlmModel</div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="small text-muted">Owner: @project.OwnerUserId</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(project.Description))
                                {
                                    <p class="mb-0 text-muted">@project.Description</p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
