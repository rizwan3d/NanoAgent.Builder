@page
@model NanoAgent.Builder.Pages.PlansModel
@{
    ViewData["Title"] = "SaaS packages";
    ViewData["UseBuilderLayout"] = true;
}

<section class="app-page">
    <div class="container-xl px-3 px-lg-4">
        <div class="app-page-header">
            <div class="app-page-copy">
                <p class="app-kicker mb-2">Plans</p>
                <h1>Pick the setup that fits your build speed.</h1>
                <p class="mb-0">Start free, stay local when you want, and move to paid plans when you need more projects, more tokens, or broader model access.</p>
            </div>
        </div>

        @if (TempData["StatusMessage"] is string message)
        {
            <div class="alert alert-success mb-4">@message</div>
        }

        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

        <div class="app-pricing-grid">
            @foreach (var plan in Model.Plans)
            {
                var isCurrentPlan = Model.CurrentSubscription?.PlanCode == plan.Code;
                <article class="app-pricing-card @(isCurrentPlan ? "current-plan" : null)">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <p class="app-kicker mb-1">@plan.Code</p>
                            <h2 class="h3 mb-2">@plan.Name</h2>
                        </div>
                        @if (isCurrentPlan)
                        {
                            <span class="builder-status-pill">Current</span>
                        }
                        else if (!plan.RequiresPayment)
                        {
                            <span class="dashboard-pill">Free</span>
                        }
                        else
                        {
                            <span class="dashboard-pill">Paid</span>
                        }
                    </div>

                    <p class="mb-0">@plan.Description</p>

                    <div>
                        <div class="app-price">
                            @(plan.MonthlyPrice == 0 ? "$0" : plan.MonthlyPrice.ToString("C0"))
                        </div>
                        <div class="small visually-muted mt-1">@(plan.MonthlyPrice == 0 ? "No monthly charge" : "Per month")</div>
                    </div>

                    <ul class="app-feature-list">
                        <li>Project limit: @plan.ProjectLimitDisplay</li>
                        <li>Monthly tokens: @plan.MonthlyTokenLimitDisplay</li>
                        <li>Models: @string.Join(", ", plan.AllowedLlmModels)</li>
                        <li>Billing: @(plan.RequiresPayment ? "Stripe subscription" : "Free monthly allowance")</li>
                        <li>Currency: @plan.Currency</li>
                        @if (plan.RequiresPayment && !plan.IsPaymentConfigured)
                        {
                            <li>Stripe price id still needs configuration</li>
                        }
                    </ul>

                    <div class="mt-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form method="post">
                                <input type="hidden" name="planCode" value="@plan.Code" />
                                <button class="btn @(isCurrentPlan ? "btn-outline-secondary" : "btn-primary") w-100"
                                        disabled="@(isCurrentPlan || !plan.IsPaymentConfigured)">
                                    @(isCurrentPlan ? "Selected" : plan.RequiresPayment ? "Subscribe with Stripe" : "Select free plan")
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary w-100" asp-page="/Account/Register">Create account</a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
